FROM node:24-slim

# Bun isn't in this image; copy the binary in so the workspace install works
COPY --from=oven/bun:1.3.13 /usr/local/bin/bun /usr/local/bin/bun
# Creates a symbolic link (shortcut) named bunx that points to the bun executable.
RUN ln -s /usr/local/bin/bun /usr/local/bin/bunx

WORKDIR /usr/src/app
ARG DATABASE_URL

#COPY PART
COPY ./package.json ./package.json
COPY ./packages ./packages  
COPY ./bun.lock ./bun.lock 
COPY ./turbo.json ./turbo.json 
COPY ./apps/web ./apps/web 


RUN bun install

RUN bun run generate:db

# WHEN YOU ARE IN THE ROOT DIR, THEN YOU CAN DO THIS

# Either run using this, without using ""
# CMD cd apps/web && bun run start

# OR THIS
# CMD ["sh", "-c", "cd apps/web && bun run start"]

# WE CAN ALSO CHANGE OUT WORKDIRECTOR
# WORKDIR /usr/src/app/apps/web

# RUN DATABASE_URL=${DATABASE_URL} bun run build

EXPOSE 3000

CMD ["sh", "-c", "bun run build && bun run start"]

# DATABASE_URL=postgresql://user:password@localhost:5432/mydb bun run build